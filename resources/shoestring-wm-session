#!/usr/bin/env bash
# Session wrapper launched by the display manager (GDM/SDDM/LightDM) when
# you pick "shoestring-wm" from the login screen. The .desktop file's
# Exec= points here, not at the bare compositor, so we can set up the
# session environment first.
#
# Why a wrapper and not Exec=shoestring-wm directly:
#   - Advertises the session to apps/portals via XDG_CURRENT_DESKTOP.
#   - Pushes our environment into the systemd user manager and the D-Bus
#     activation environment, so dbus-activated services (the notify
#     daemon, xdg-desktop-portal, ...) and `systemctl --user` units
#     inherit WAYLAND_DISPLAY and friends.
#   - Cleans that state back up on exit.
set -euo pipefail

export XDG_CURRENT_DESKTOP=shoestring-wm
export XDG_SESSION_TYPE=wayland

# Display managers launch the session with a minimal PATH (typically just
# /usr/bin and friends) that omits the per-user bin dirs. The compositor
# spawns terminals, launchers, and autostart entries by bare name, so
# anything you installed with `cargo install` (~/.cargo/bin, e.g.
# alacritty, shoestring-bar) or dropped in ~/.local/bin would otherwise be
# "command not found". Prepend them so user-installed apps are launchable.
# Honors XDG_DATA_HOME / CARGO_HOME if set.
for d in "${HOME}/.local/bin" "${CARGO_HOME:-$HOME/.cargo}/bin"; do
    case ":${PATH}:" in
        *":${d}:"*) ;;                 # already present — don't duplicate
        *) [ -d "${d}" ] && PATH="${d}:${PATH}" ;;
    esac
done
export PATH

# Log to a file so GDM's stdout=/dev/null redirect doesn't swallow diagnostics.
# Set RUST_LOG=shoestring_wm=info (default) or =debug for verbose output.
# The log rotates every session: previous run is kept as .log.old.
# If the old log is suspiciously large (>10 MB — shouldn't happen at info
# level but guards against a runaway debug session), drop it instead of
# keeping it so we don't fill the XDG_RUNTIME_DIR tmpfs.
_logdir="${XDG_RUNTIME_DIR:-/tmp}"
_logfile="${_logdir}/shoestring-wm.log"
if [ -f "${_logfile}" ]; then
    _logsize=$(wc -c < "${_logfile}" 2>/dev/null || echo 0)
    if [ "${_logsize}" -gt $((10 * 1024 * 1024)) ]; then
        rm -f "${_logfile}"
    else
        mv -f "${_logfile}" "${_logfile}.old"
    fi
fi
export SHOESTRING_WM_LOG="${_logfile}"
export RUST_LOG="${RUST_LOG:-shoestring_wm=info,smithay=warn}"

# Seed the static session variables into the systemd user manager *and* the
# D-Bus session daemon's own activation-environment cache — the two are
# independent stores, and portal/notification-daemon services are spawned by
# whichever one D-Bus itself uses for their (typically plain Exec=, no
# SystemdService=) activation. Importing into only the systemd side leaves
# XDG_CURRENT_DESKTOP unset for those services, so xdg-desktop-portal can
# never resolve our ScreenCast/Screenshot backend. The compositor imports the
# dynamic runtime variables (WAYLAND_DISPLAY, DISPLAY) the same way, via
# import_systemd_env(), once it has set them up.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_TYPE PATH || true
fi
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP XDG_SESSION_TYPE PATH || true
fi

# Hand off to the compositor. exec so the session lifetime == the WM's:
# when shoestring-wm exits, the display manager returns to the greeter.
# Backend auto-detects to `tty` here (no WAYLAND_DISPLAY/DISPLAY set).
exec shoestring-wm "$@"
